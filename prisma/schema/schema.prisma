// KuBi — Phase 1 Step 5.
// Foundation entities ONLY: organization and clinic, per the approved plan.
// No clinical, workflow or RBAC entities are modelled in Phase 1.
//
// Tenancy (ADR-003): every tenant-scoped table carries BOTH organization_id and
// clinic_id. Row-level security policies key on organisation first, clinic
// second. See prisma/migrations/*/rls.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// Top-level tenant. ADR-003 keeps this distinct from Clinic so that
/// multi-organisation SaaS remains possible without a core redesign.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinics               Clinic[]
  patients              Patient[]
  users                 User[]
  employees             Employee[]
  clinicalAuthorities   ClinicalAuthority[]
  roles                 Role[]
  rolePermissions       RolePermission[]
  employeeRoles         EmployeeRole[]
  functionalAssignments FunctionalAssignment[]
  employeeCompetencies  EmployeeCompetency[]
  configValues          ConfigValue[]
  auditLogs             AuditLog[]
  breakGlassGrants      BreakGlassGrant[]
  refreshTokens         RefreshToken[]
  activityDefinitions   ActivityDefinition[]
  checklistItemDefs     ChecklistItemDefinition[]
  activityInstances     ActivityInstance[]
  checklistResponses    ChecklistResponse[]
  evidence              Evidence[]
  verifications         Verification[]
  attentionItems        AttentionItem[]
  notifications         Notification[]
  uxEvents              UxEvent[]
  automationExecutions  AutomationExecution[]
  appointments          Appointment[]

  incidents            Incident[]
  capaActions          CapaAction[]
  procedures           Procedure[]
  patientProcedures    PatientProcedure[]
  consents             Consent[]
  followups            Followup[]
  assets               Asset[]
  maintenancePlans     MaintenancePlan[]
  assetChecks          AssetCheck[]
  breakdowns           Breakdown[]
  items                Item[]
  stockBatches         StockBatch[]
  implantSkus          ImplantSku[]
  sterilizationBatches SterilizationBatch[]
  labCases             LabCase[]
  retentionOutreach    RetentionOutreach[]
  clinicEvents         ClinicEventRow[]
  operatories          Operatory[]

  @@map("organizations")
}

/// Second tenancy level. Physical operating site.
model Clinic {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  /// IANA timezone. All trigger evaluation is clinic-local and DST-aware.
  timezone       String   @default("Asia/Kolkata")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("clinics")
}

/// Present in Phase 1 ONLY as the RLS spike fixture (Step 6).
///
/// ADR-002: patient identity is ORGANISATION-wide with a single org-wide UHID.
/// clinic_id here records the clinic of REGISTRATION, not an access boundary —
/// visibility across clinics is a permission (patient:view_all_clinics), which
/// is why this table exercises both tenancy levels and is the correct fixture
/// for proving two-level RLS.
///
/// No clinical fields are modelled. Phase 1 control 14.
model Patient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  uhid           String
  displayLabel   String   @map("display_label")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  patientProcedures PatientProcedure[]
  consents          Consent[]
  followups         Followup[]

  labCases          LabCase[]
  retentionOutreach RetentionOutreach[]

  @@unique([organizationId, uhid])
  @@index([organizationId, clinicId])
  @@map("patients")
}

// =============================================================================
// PHASE 2 — Identity, Access, Organization & RBAC foundation
//
// Authority is kept on SEVEN distinct axes throughout (Phase 0 §09, CLAUDE.md
// non-negotiable 5): User, Employee, Role, Permission, Clinical Authority,
// Functional Assignment, and Record Relation (the last is resolved in code —
// ActorRefKind.RECORD_RELATION — not a table, because it is a relationship to
// whatever record is being acted on, not a standing grant).
// =============================================================================

/// Authentication identity. Owns credentials, sessions, MFA — and NOTHING else.
/// Deliberately separate from Employee: a user account carries no clinical or
/// organisational meaning by itself (Phase 0 §09).
model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String
  passwordHash   String   @map("password_hash")
  /// Reserved for TOTP MFA. Not enforced in Phase 2 — see technical debt TD-9.
  mfaEnabled     Boolean  @default(false) @map("mfa_enabled")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  employee      Employee?
  refreshTokens RefreshToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

/// The HR record. May exist with NO user account — a visiting hygienist can be
/// a Doer without ever logging in (Phase 0 §09). `userId` is nullable and
/// unique: at most one user per employee, at most one employee per user.
model Employee {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  userId             String?  @unique @map("user_id") @db.Uuid
  code               String
  displayLabel       String   @map("display_label")
  /// Self-referencing: drives escalation targeting (REPORTING_MANAGER_OF), not
  /// authorization. A manager cannot necessarily do their report's job.
  reportingManagerId String?  @map("reporting_manager_id") @db.Uuid
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id])
  user                  User?                  @relation(fields: [userId], references: [id])
  reportingManager      Employee?              @relation("EmployeeReports", fields: [reportingManagerId], references: [id])
  reports               Employee[]             @relation("EmployeeReports")
  clinicalAuthority     ClinicalAuthority?
  roles                 EmployeeRole[]
  functionalAssignments FunctionalAssignment[]
  competencies          EmployeeCompetency[]
  breakGlassGrants      BreakGlassGrant[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("employees")
}

/// A SEPARATE, revocable, auditable attribute — never implied by role.
/// "System Administrator status must not automatically provide clinical
/// authority" (FRS §3) is mechanised here: nothing about being an admin, a
/// manager, or an owner creates a row in this table. Only an explicit,
/// reasoned grant does, and it is independently revocable.
model ClinicalAuthority {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @unique @map("employee_id") @db.Uuid
  granted        Boolean   @default(false)
  licenseNumber  String?   @map("license_number")
  grantedBy      String?   @map("granted_by") @db.Uuid
  grantedAt      DateTime? @map("granted_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("clinical_authorities")
}

/// A named bundle of permissions. Org-scoped (Phase 0.5 §08: roles are
/// deliberately NOT clinic-configurable — per-clinic permission drift is how
/// audit trails become unexplainable). `isSystemRole` protects the 13
/// canonical FRS §3 roles from deletion; organisations may add custom roles
/// later without touching the canonical set.
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  isSystemRole   Boolean  @default(true) @map("is_system_role")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  employees    EmployeeRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

/// The permission CATALOGUE. Global reference data, not tenant data — every
/// organisation shares the same permission codes (resource:action), which is
/// what makes cross-org comparison and product-wide upgrades possible. NOT
/// row-level-secured: it is non-sensitive, immutable-by-convention metadata.
model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource  String
  action    String
  /// `resource:action`. Stable for the life of the product — appears in audit
  /// records, so renaming rewrites history and is forbidden after release.
  code      String   @unique
  /// PermissionClass: STANDARD | CLINICAL | SAFETY_OVERRIDE | ADMIN | BREAK_GLASS
  class     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from role.organizationId — RLS on this table needs a direct
  /// column rather than a policy subquery through Role.
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionId   String   @map("permission_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  permission   Permission   @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@map("role_permissions")
}

/// The employee<->role link. THIS is where multi-role, clinic-scoped,
/// effective-dated assignment lives (Epic E01: "assign multiple clinic-
/// specific roles... effective dates... audit log").
///
/// `clinicId = NULL` means an org-wide (cross-clinic) grant — the same
/// semantics as `TenancyContext.crossClinic`. A non-null clinicId scopes the
/// grant to exactly that clinic.
model EmployeeRole {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clinicId       String?   @map("clinic_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  grantedBy      String?   @map("granted_by") @db.Uuid
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  reason         String?

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, clinicId])
  @@index([employeeId])
  @@map("employee_roles")
}

/// A named clinic responsibility held by one or more employees, INDEPENDENT
/// of role (Phase 0.5 D2 finding: "Equipment Owner", "Implant Coordinator",
/// "Trainer", "Qualified Assessor", "Qualified Verifier" are per-clinic
/// assignments, not roles — making them roles would multiply the role count
/// and still fail to express "the owner of THIS asset").
///
/// `scopeRef` optionally narrows the assignment to one record (e.g. one
/// asset's Equipment Owner) rather than a clinic-wide responsibility.
model FunctionalAssignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  clinicId       String    @map("clinic_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  /// FunctionalAssignmentType — see packages/contracts.
  assignmentType String    @map("assignment_type")
  scopeRef       String?   @map("scope_ref")
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  grantedBy      String?   @map("granted_by") @db.Uuid
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId, clinicId])
  @@index([employeeId])
  @@map("functional_assignments")
}

/// The authorization SEAM for competency (owner Additional Principle 2 /
/// ADR-014). The Assignment engine's gate G-09 reads this table from Phase 2
/// onward even though the Training & Competency MODULE (assessment workflow,
/// UI) is Phase 3. Absence of a row for a required skill resolves to
/// NOT_CONFIGURED, never PASS.
model EmployeeCompetency {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  skillCode      String    @map("skill_code")
  /// CompetencyLevel: NOT_TRAINED | TRAINED | SUPERVISED | INDEPENDENT | TRAINER
  level          String
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(6)
  assessedBy     String?   @map("assessed_by") @db.Uuid
  assessedAt     DateTime  @default(now()) @map("assessed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, skillCode])
  @@index([organizationId])
  @@map("employee_competencies")
}

/// Minimal configuration registry — enough to satisfy the P-2/D-01 condition
/// that jurisdiction-specific policy be configurable, not hard-coded, without
/// building the full Phase 0.5 §15 94-key registry (that is Phase 3+ work,
/// once the activities/procedures it configures actually exist).
model ConfigValue {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clinicId       String?  @map("clinic_id") @db.Uuid
  /// ConfigScope: ORGANIZATION | CLINIC (ACTIVITY/PROCEDURE/ROLE/SYSTEM unused
  /// until their owning entities exist).
  scope          String
  key            String
  valueJson      Json     @map("value_json") @db.JsonB
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, clinicId, key])
  @@index([organizationId])
  @@map("config_values")
}

/// Append-only. Change-data-capture half of the two-mechanism audit
/// architecture (Phase 0 §14) — actor, before/after, reason, correlation id.
/// UPDATE and DELETE are revoked from kubi_app at the grant level AND refused
/// by a trigger, so neither an application bug nor a hand-written migration
/// can rewrite history (see migration 0003_identity_rbac.sql).
model AuditLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  clinicId        String?  @map("clinic_id") @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  actorEmployeeId String?  @map("actor_employee_id") @db.Uuid
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id") @db.Uuid
  oldValue        Json?    @map("old_value") @db.JsonB
  newValue        Json?    @map("new_value") @db.JsonB
  reason          String?
  correlationId   String?  @map("correlation_id")
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, occurredAt])
  @@map("audit_logs")
}

/// Time-boxed, reason-required, separately-audited elevation. The ENTIRE
/// escape hatch (Phase 0 §09) — there is no `if (isAdmin) return true` path
/// anywhere in the codebase; break-glass is the only route past an ordinary
/// permission denial, and it is itself gated by a BREAK_GLASS-class
/// permission that no standing role may hold.
model BreakGlassGrant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  permissionCode String    @map("permission_code")
  reason         String
  requestedBy    String    @map("requested_by") @db.Uuid
  approvedBy     String?   @map("approved_by") @db.Uuid
  activatedAt    DateTime  @default(now()) @map("activated_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("break_glass_grants")
}

/// Rotating refresh tokens. Only the hash is stored; rotation forms a chain
/// via `replacedByTokenId` so reuse of a superseded token is detectable.
model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@map("refresh_tokens")
}

// =============================================================================
// VS-01 — Activity engine. Internal names follow the frozen Blueprint v0.1
// philosophy (WORK / CHECK / PROBLEM / FIX / IMPROVE); user-facing strings
// use clinic language (Today / Attention / ...). Never leak these table names.
// =============================================================================

/// A standard, normalised from Matrix v2.0. Versioned: instances pin the
/// version they were created under, so a definition edited in June cannot
/// retroactively change what March's completed work was measured against.
model ActivityDefinition {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  /// Matrix v2.0 Activity ID, e.g. OPN-001. Natural key, never reissued.
  code              String
  version           Int      @default(1)
  /// Plain-language task title shown to staff. NOT the Matrix "Activity" text
  /// verbatim where that text is written for auditors rather than doers.
  title             String
  /// Matrix "Standard / Expected Result" — shown as supporting text.
  standardText      String   @map("standard_text")
  /// One of the 16 control parameters (see Parameter in contracts). The axis
  /// the owner's dashboard rolls up. Distinct from `process`: a parameter is
  /// what kind of control this is, a process is the workflow it sits in.
  parameter         String
  process           String
  priority          String
  executionMode     String   @map("execution_mode")
  recurrence        String
  instanceScope     String   @map("instance_scope")
  /// DueRule as JSON — see DueRuleKind in contracts.
  dueRule           Json     @map("due_rule") @db.JsonB
  /// Assignment rules as JSON: { doer, checker, owner } each an ActorRef.
  assignmentRule    Json     @map("assignment_rule") @db.JsonB
  /// SodPolicy: STRICT | OVERRIDABLE | NOT_REQUIRED
  sodPolicy         String   @map("sod_policy")
  /// True only for the OD-02 approved allowlist (VS-01: OPN-003, OPN-004).
  selfVerifyAllowed Boolean  @default(false) @map("self_verify_allowed")
  evidenceType      String   @map("evidence_type")
  /// Gate requirement code, if this activity depends on one. Null = no gate.
  gateRequirement   String?  @map("gate_requirement")
  /// EnforcementMode for the gate. Read from config, not hard-coded.
  gateEnforcement   String?  @map("gate_enforcement")
  failureDefinition String   @map("failure_definition")
  escalationPolicy  String   @map("escalation_policy")
  capaPolicy        String   @map("capa_policy")
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization              @relation(fields: [organizationId], references: [id])
  checklistItems ChecklistItemDefinition[]
  instances      ActivityInstance[]

  @@unique([organizationId, code, version])
  @@index([organizationId])
  @@map("activity_definitions")
}

model ChecklistItemDefinition {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  definitionId   String  @map("definition_id") @db.Uuid
  ordinal        Int
  /// Plain clinic language. "Chair and light working", not "asset_check_1".
  label          String
  /// If true this item captures a VALUE (e.g. AC temperature), not just a tick.
  requiresValue  Boolean @default(false) @map("requires_value")
  valueUnit      String? @map("value_unit")
  valueMin       Float?  @map("value_min")
  valueMax       Float?  @map("value_max")

  organization Organization        @relation(fields: [organizationId], references: [id])
  definition   ActivityDefinition  @relation(fields: [definitionId], references: [id])
  responses    ChecklistResponse[]

  @@unique([definitionId, ordinal])
  @@index([organizationId])
  @@map("checklist_item_definitions")
}

/// The runtime unit of WORK. Idempotency is a DB constraint, not app logic:
/// re-running the scheduler cannot duplicate a task.
model ActivityInstance {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String    @map("organization_id") @db.Uuid
  clinicId                   String    @map("clinic_id") @db.Uuid
  definitionId               String    @map("definition_id") @db.Uuid
  definitionVersion          Int       @map("definition_version")
  /// The entity giving this instance its identity (InstanceScope). For
  /// CLINIC_DAY this is the clinic-local date string.
  scopeKey                   String    @map("scope_key")
  /// Clinic-local period, e.g. "2026-07-28". Part of the idempotency key.
  periodKey                  String    @map("period_key")
  status                     String
  assigneeEmployeeId         String?   @map("assignee_employee_id") @db.Uuid
  dueAt                      DateTime  @map("due_at") @db.Timestamptz(6)
  startedAt                  DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt                DateTime? @map("completed_at") @db.Timestamptz(6)
  completedByEmployeeId      String?   @map("completed_by_employee_id") @db.Uuid
  verifiedAt                 DateTime? @map("verified_at") @db.Timestamptz(6)
  /// Set when the task cannot proceed because a PROBLEM was reported.
  blockedByItemId            String?   @map("blocked_by_item_id") @db.Uuid
  /// Usability review Q2 follow-through. Proceeding when a requirement cannot
  /// be confirmed is management authority, but only the assignee may do the
  /// work. A manager authorises THIS instance; the assignee then finishes it.
  /// Neither person can do the other's part, which is the point.
  gateAuthorisedByEmployeeId String?   @map("gate_authorised_by_employee_id") @db.Uuid
  gateAuthorisedAt           DateTime? @map("gate_authorised_at") @db.Timestamptz(6)
  gateAuthorisationReason    String?   @map("gate_authorisation_reason")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id])
  definition     ActivityDefinition  @relation(fields: [definitionId], references: [id])
  responses      ChecklistResponse[]
  evidence       Evidence[]
  verifications  Verification[]
  attentionItems AttentionItem[]
  incidents      Incident[]

  @@unique([definitionId, scopeKey, periodKey])
  @@index([organizationId, clinicId, status])
  @@index([assigneeEmployeeId, status])
  @@map("activity_instances")
}

model ChecklistResponse {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  instanceId            String   @map("instance_id") @db.Uuid
  itemId                String   @map("item_id") @db.Uuid
  checked               Boolean  @default(false)
  numericValue          Float?   @map("numeric_value")
  respondedByEmployeeId String   @map("responded_by_employee_id") @db.Uuid
  respondedAt           DateTime @default(now()) @map("responded_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id])
  instance     ActivityInstance        @relation(fields: [instanceId], references: [id])
  item         ChecklistItemDefinition @relation(fields: [itemId], references: [id])

  @@unique([instanceId, itemId])
  @@index([organizationId])
  @@map("checklist_responses")
}

/// Append-only. Corrections supersede rather than mutate.
model Evidence {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  instanceId           String   @map("instance_id") @db.Uuid
  evidenceType         String   @map("evidence_type")
  payload              Json     @db.JsonB
  capturedByEmployeeId String   @map("captured_by_employee_id") @db.Uuid
  capturedAt           DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  supersededById       String?  @map("superseded_by_id") @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id])
  instance     ActivityInstance @relation(fields: [instanceId], references: [id])

  @@index([organizationId])
  @@index([instanceId])
  @@map("evidence")
}

/// A CHECK. Records whether it was independent or an approved self-verification.
model Verification {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  instanceId         String   @map("instance_id") @db.Uuid
  verifierEmployeeId String   @map("verifier_employee_id") @db.Uuid
  /// PASS | FAIL
  result             String
  /// True when verifier == doer under an OD-02 approved allowlist entry.
  selfVerified       Boolean  @default(false) @map("self_verified")
  comment            String?
  verifiedAt         DateTime @default(now()) @map("verified_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  instance     ActivityInstance @relation(fields: [instanceId], references: [id])

  @@index([organizationId])
  @@index([instanceId])
  @@map("verifications")
}

/// A PROBLEM. Internally carries taxonomy + severity + SLA; the UI shows
/// plain language only.
model AttentionItem {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  clinicId             String    @map("clinic_id") @db.Uuid
  /// Internal taxonomy code, e.g. OPN.PHYSICAL_FAILURE.ROOM_NOT_READY.
  code                 String
  severity             String
  /// Plain-language headline shown to staff.
  headline             String
  detail               String?
  sourceInstanceId     String?   @map("source_instance_id") @db.Uuid
  /// Who must act. Resolved relationally at creation time.
  ownerEmployeeId      String?   @map("owner_employee_id") @db.Uuid
  status               String    @default("OPEN")
  dueAt                DateTime  @map("due_at") @db.Timestamptz(6)
  escalationLevel      String    @default("INITIAL") @map("escalation_level")
  escalatedAt          DateTime? @map("escalated_at") @db.Timestamptz(6)
  acknowledgedAt       DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByEmployeeId String?   @map("resolved_by_employee_id") @db.Uuid
  resolutionNote       String?   @map("resolution_note")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization      @relation(fields: [organizationId], references: [id])
  sourceInstance ActivityInstance? @relation(fields: [sourceInstanceId], references: [id])
  notifications  Notification[]

  @@index([organizationId, clinicId, status])
  @@index([ownerEmployeeId, status])
  @@map("attention_items")
}

model Notification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  recipientEmployeeId String    @map("recipient_employee_id") @db.Uuid
  priority            String
  headline            String
  attentionItemId     String?   @map("attention_item_id") @db.Uuid
  readAt              DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  attentionItem AttentionItem? @relation(fields: [attentionItemId], references: [id])

  @@index([organizationId])
  @@index([recipientEmployeeId, readAt])
  @@map("notifications")
}

/// UX instrumentation. No PHI — event names, ids and durations only.
model UxEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String?  @map("employee_id") @db.Uuid
  eventName      String   @map("event_name")
  instanceId     String?  @map("instance_id") @db.Uuid
  sessionKey     String?  @map("session_key")
  durationMs     Int?     @map("duration_ms")
  metadata       Json?    @db.JsonB
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, eventName])
  @@map("ux_events")
}

/// Records every scheduler evaluation, INCLUDING no-ops, so "why didn't my
/// task appear?" is answerable.
model AutomationExecution {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  ruleCode       String   @map("rule_code")
  periodKey      String   @map("period_key")
  outcome        String
  detail         Json?    @db.JsonB
  executedAt     DateTime @default(now()) @map("executed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, clinicId, ruleCode])
  @@map("automation_executions")
}

// =============================================================================
// VS-02 — Appointments
//
// The clinic's day is driven by patients arriving, not by a task list. These
// tables are what let KuBi say "first patient at 09:55" and mean it.
//
// Deliberately minimal: no treatment, no billing, no clinical content. VS-02
// integrates the SCHEDULE, which is what the operating assistant needs to know
// where the day is. Clinical records remain out of scope.
// =============================================================================

model Appointment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  clinicId           String    @map("clinic_id") @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  /// The treating employee. Nullable: a slot can be booked before it is
  /// assigned, and pretending otherwise would force a wrong answer.
  providerEmployeeId String?   @map("provider_employee_id") @db.Uuid
  /// Clinic-local date, "2026-07-29". Matches the activity engine's periodKey
  /// so a day's schedule and a day's opening line up without timezone maths.
  periodKey          String    @map("period_key")
  scheduledStart     DateTime  @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd       DateTime  @map("scheduled_end") @db.Timestamptz(6)
  /// Where it happens. A label, not a table: rooms are named, not modelled,
  /// until there is a reason to model them.
  chairLabel         String?   @map("chair_label")
  /// What kind of visit, in clinic words ("Check-up", "Root canal").
  visitType          String    @map("visit_type")
  /// BOOKED | ARRIVED | IN_CHAIR | COMPLETED | CANCELLED | NO_SHOW
  status             String    @default("BOOKED")
  arrivedAt          DateTime? @map("arrived_at") @db.Timestamptz(6)
  seatedAt           DateTime? @map("seated_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?   @map("cancel_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, clinicId, periodKey])
  @@index([organizationId, clinicId, status])
  @@map("appointments")
}

/// The IMPROVE stage of the §8 loop — how the clinic learns from a failure
/// instead of correcting the same one forever.
///
/// The requirement's chain is: what happened → immediate correction → why did
/// it happen → root cause → corrective action → preventive action →
/// responsible person → due date → verification → closed. Each field below is
/// one link of it, and the service refuses transitions that skip a link.
model Incident {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  /// Human-facing reference, e.g. INC-2026-0001. Stable once issued.
  reference String
  /// EXCEPTION when raised automatically by CAPA policy; MANUAL otherwise.
  source    String @default("MANUAL")
  /// Which of the 16 control parameters this failure belongs to.
  parameter String
  /// Routine / Important / Critical / Patient Safety. Drives nothing's colour
  /// on its own — it decides how hard the closing rules bite.
  priority  String
  status    String @default("OPEN")

  /// What happened, in clinic words.
  summary     String
  description String?

  /// The immediate correction: what was done about today. Recorded before any
  /// investigation, because the patient in the chair cannot wait for a root
  /// cause analysis.
  immediateCorrection String?   @map("immediate_correction")
  containedAt         DateTime? @map("contained_at") @db.Timestamptz(6)

  /// Why it happened. The link the whole parameter exists to force.
  rootCause      String?   @map("root_cause")
  investigatedAt DateTime? @map("investigated_at") @db.Timestamptz(6)

  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)

  /// The exception that raised this, when it was raised automatically.
  sourceAttentionItemId String? @map("source_attention_item_id") @db.Uuid
  /// The activity instance that failed, when there was one.
  sourceInstanceId      String? @map("source_instance_id") @db.Uuid

  reportedByEmployeeId String? @map("reported_by_employee_id") @db.Uuid
  ownerEmployeeId      String? @map("owner_employee_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization      @relation(fields: [organizationId], references: [id])
  sourceInstance ActivityInstance? @relation(fields: [sourceInstanceId], references: [id])
  actions        CapaAction[]

  @@unique([organizationId, reference])
  @@index([organizationId, clinicId, status])
  @@index([organizationId, clinicId, parameter])
  @@map("incidents")
}

/// One corrective or preventive action on an incident.
///
/// Separate rows rather than two text fields on the incident, because each
/// action needs its own owner, due date and independent verification — and
/// because "at least one PREVENTIVE action exists" is the rule that stops CAPA
/// degenerating into a log of things that were fixed once.
model CapaAction {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  incidentId     String @map("incident_id") @db.Uuid

  /// CORRECTIVE fixes this instance; PREVENTIVE stops the next one.
  type        String
  description String
  status      String @default("OPEN")

  responsibleEmployeeId String   @map("responsible_employee_id") @db.Uuid
  dueAt                 DateTime @map("due_at") @db.Timestamptz(6)

  /// Carried out. Emphatically not the same as "it worked".
  implementedAt DateTime? @map("implemented_at") @db.Timestamptz(6)

  /// When the effectiveness check falls due (Matrix v2.0 INC-006 — a
  /// configured date, not immediately). Set when the action is implemented.
  effectivenessDueAt DateTime? @map("effectiveness_due_at") @db.Timestamptz(6)

  /// The effectiveness check is by someone other than the responsible person,
  /// for the same reason a doer cannot confirm their own activity.
  verifiedByEmployeeId String?   @map("verified_by_employee_id") @db.Uuid
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(6)
  verificationNote     String?   @map("verification_note")

  /// How many times this action was found ineffective and sent back. A CAPA on
  /// its third attempt is a different conversation from one on its first, and
  /// that is only visible if the count survives the loop.
  ineffectiveCount Int @default(0) @map("ineffective_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([organizationId, incidentId])
  @@index([responsibleEmployeeId, status])
  @@map("capa_actions")
}

/// A procedure protocol — the master record that decides what must be true
/// before this kind of treatment may start.
///
/// The Operations App calls this the point where "KuBi becomes significantly
/// more useful than ordinary clinic software": the selected procedure
/// determines the required checklist, so an RCT and an implant surgery ask for
/// different things without anyone remembering to.
model Procedure {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  code     String
  name     String
  /// OD-06 is OPEN: only SURGERY and IMPLANT_SURGERY are confirmed by the
  /// Build Pack. No protocol may be seeded against an unconfirmed category.
  category String

  /// Follow-up offsets in days, generated when the procedure completes.
  /// FUP-002 makes the day-after call mandatory for surgery.
  followupOffsetDays Int[] @default([]) @map("followup_offset_days")

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization           @relation(fields: [organizationId], references: [id])
  requirements      ProcedureRequirement[]
  patientProcedures PatientProcedure[]

  @@unique([organizationId, code])
  @@map("procedures")
}

/// One thing that must be true before a procedure may start.
///
/// Enforcement is per-requirement rather than global: a missing consent blocks
/// hard, a missing pre-op photograph warns. The mode is data, not code, which
/// is what "configuration before hard-coding" means in practice.
model ProcedureRequirement {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procedureId String @map("procedure_id") @db.Uuid

  /// What is being required — CONSENT, MEDICAL_HISTORY, RADIOGRAPH, and so on.
  kind        String
  label       String
  /// ADVISORY | BLOCK_OVERRIDABLE | BLOCK_HARD. Drives the enforcement matrix.
  enforcement String
  /// Gate code, where this requirement corresponds to a registered gate.
  /// The immutable BLOCK_HARD gates have no override permission in existence.
  gateCode    String? @map("gate_code")
  sortOrder   Int     @default(0) @map("sort_order")

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([procedureId, kind])
  @@map("procedure_requirements")
}

/// A procedure booked or performed for one patient.
model PatientProcedure {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  patientId     String  @map("patient_id") @db.Uuid
  procedureId   String  @map("procedure_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid

  status String @default("PLANNED")

  /// Last evaluated readiness. A cache of the evaluation, never the authority:
  /// the gate is recomputed server-side at the moment of starting, because a
  /// stored READY from an hour ago is not evidence that it is ready now.
  readiness            String    @default("PENDING")
  readinessEvaluatedAt DateTime? @map("readiness_evaluated_at") @db.Timestamptz(6)

  /// The implant components this specific case needs, as recorded when it was
  /// planned. Held on the case rather than derived from the procedure, because
  /// two implant surgeries of the same protocol need different platforms and
  /// dimensions — which is precisely why counting implants is insufficient.
  componentRequirements Json? @map("component_requirements")

  /// Set only when an authorised person overrode a BLOCK_OVERRIDABLE gate.
  /// BLOCK_HARD has no override path at all — enforced by the absence of a
  /// permission, not by a check here.
  overriddenByEmployeeId String?   @map("overridden_by_employee_id") @db.Uuid
  overrideReason         String?   @map("override_reason")
  overriddenAt           DateTime? @map("overridden_at") @db.Timestamptz(6)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  procedure    Procedure    @relation(fields: [procedureId], references: [id])
  consents     Consent[]
  followups    Followup[]

  @@index([organizationId, clinicId, status])
  @@index([patientId])
  @@map("patient_procedures")
}

/// A recorded consent. Signed, versioned, and never editable after the fact.
model Consent {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  patientId          String  @map("patient_id") @db.Uuid
  patientProcedureId String? @map("patient_procedure_id") @db.Uuid

  consentType     String @map("consent_type")
  /// The template version signed. A consent is only evidence of what the
  /// patient actually saw, so the version is part of the record.
  templateCode    String @map("template_code")
  templateVersion Int    @map("template_version")

  signedAt          DateTime  @map("signed_at") @db.Timestamptz(6)
  witnessEmployeeId String?   @map("witness_employee_id") @db.Uuid
  /// Consent can be withdrawn. A withdrawn consent stops satisfying its gate.
  withdrawnAt       DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  patientProcedure PatientProcedure? @relation(fields: [patientProcedureId], references: [id])

  @@index([organizationId, patientId])
  @@map("consents")
}

/// A follow-up generated by a completed procedure (FUP-001, FUP-002).
///
/// The response is structured rather than a "called" tick, because the
/// requirement is explicit that it must be: pain, swelling, bleeding and
/// medication are each recorded, and a red-flag combination raises a clinical
/// review by itself rather than relying on whoever made the call to judge it.
model Followup {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  patientId          String @map("patient_id") @db.Uuid
  patientProcedureId String @map("patient_procedure_id") @db.Uuid

  dueAt              DateTime @map("due_at") @db.Timestamptz(6)
  assignedEmployeeId String?  @map("assigned_employee_id") @db.Uuid

  outcome String @default("PENDING")

  /// NONE | MILD | MODERATE | SEVERE
  pain           String?
  /// EXPECTED | EXCESSIVE
  swelling       String?
  /// NO | YES
  bleeding       String?
  /// TAKING | PROBLEM
  medication     String?
  otherComplaint Boolean? @map("other_complaint")

  /// Set by the engine, not by the caller. Whoever makes the call records
  /// symptoms; deciding whether they are dangerous is not their job.
  redFlag         Boolean   @default(false) @map("red_flag")
  redFlagReason   String?   @map("red_flag_reason")
  escalatedItemId String?   @map("escalated_item_id") @db.Uuid
  contactedAt     DateTime? @map("contacted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  patientProcedure PatientProcedure @relation(fields: [patientProcedureId], references: [id])

  @@index([organizationId, clinicId, outcome])
  @@index([dueAt])
  @@map("followups")
}

// ---------------------------------------------------------------------------
// Equipment engine — "every important asset should have its own digital record"
// ---------------------------------------------------------------------------

/// One piece of equipment the clinic depends on.
///
/// `status` is the field that matters operationally: a failed daily check must
/// take the asset out of service, and an out-of-service chair must stop being
/// allocatable. That is the requirement's own rule — "if OPEN-004 dental chair
/// = FAIL, that chair becomes NOT AVAILABLE FOR PATIENT ALLOCATION" — and it
/// only works if availability is derived from this column rather than from
/// somebody remembering.
model Asset {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  /// Human-facing tag, e.g. AUTOCLAVE-01. Stable for the asset's life.
  code     String
  name     String
  category String
  location String?

  /// OPERATIONAL | RESTRICTED | OUT_OF_SERVICE | UNDER_REPAIR | RETIRED
  status String @default("OPERATIONAL")

  /// Who is accountable for this asset, distinct from whoever uses it.
  responsibleEmployeeId String? @map("responsible_employee_id") @db.Uuid

  amcVendor   String?   @map("amc_vendor")
  amcExpiryAt DateTime? @map("amc_expiry_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  maintenancePlans MaintenancePlan[]
  breakdowns       Breakdown[]
  checks           AssetCheck[]

  @@unique([organizationId, code])
  @@index([organizationId, clinicId, status])
  @@map("assets")
}

/// A recurring service or calibration schedule. "Next service = today"
/// generates the task, which is the whole of the Equipment engine's time half.
model MaintenancePlan {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  assetId        String @map("asset_id") @db.Uuid

  kind         String
  intervalDays Int    @map("interval_days")
  /// How many days before the due date the task should appear. A service task
  /// created on the morning it is due is a service that happens tomorrow.
  leadTimeDays Int    @default(7) @map("lead_time_days")

  lastServicedAt DateTime? @map("last_serviced_at") @db.Timestamptz(6)
  nextDueAt      DateTime  @map("next_due_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, nextDueAt])
  @@map("maintenance_plans")
}

/// A daily functional check on an asset (EQP-001). A FAIL is not a note — it
/// changes the asset's status and raises a patient-safety exception.
model AssetCheck {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  assetId             String   @map("asset_id") @db.Uuid
  periodKey           String   @map("period_key")
  result              String
  note                String?
  checkedByEmployeeId String?  @map("checked_by_employee_id") @db.Uuid
  checkedAt           DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, periodKey])
  @@map("asset_checks")
}

model Breakdown {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  assetId              String    @map("asset_id") @db.Uuid
  reportedAt           DateTime  @default(now()) @map("reported_at") @db.Timestamptz(6)
  reportedByEmployeeId String?   @map("reported_by_employee_id") @db.Uuid
  description          String
  /// Return to service is a decision somebody makes and signs, never a
  /// timestamp that arrives on its own (EQP-006).
  repairedAt           DateTime? @map("repaired_at") @db.Timestamptz(6)
  verifiedByEmployeeId String?   @map("verified_by_employee_id") @db.Uuid
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, assetId])
  @@map("breakdowns")
}

// ---------------------------------------------------------------------------
// Inventory engine
// ---------------------------------------------------------------------------

model Item {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  code     String
  name     String
  category String
  unit     String

  minimumQty   Int @map("minimum_qty")
  reorderQty   Int @map("reorder_qty")
  /// Reorder level is the trigger; minimum is the floor. Below reorder raises
  /// a purchase requirement; below minimum is a shortage, which is worse.
  reorderLevel Int @map("reorder_level")

  supplier String?
  location String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  batches      StockBatch[]

  @@unique([organizationId, code])
  @@index([organizationId, clinicId])
  @@map("items")
}

/// Stock held as batches, because expiry is per batch and FEFO needs it.
/// Expired stock is excluded from usable stock rather than deleted — the
/// history of what was held and when it expired is the audit trail.
model StockBatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  batchRef       String    @map("batch_ref")
  quantity       Int
  expiryAt       DateTime? @map("expiry_at") @db.Timestamptz(6)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([organizationId, itemId])
  @@index([expiryAt])
  @@map("stock_batches")
}

/// Implant stock, tracked to the component.
///
/// The requirement is explicit that quantity alone is clinically insufficient:
/// "merely knowing 10 implants available" says nothing about whether the right
/// platform, diameter and length are present, let alone the healing abutment
/// and prosthetic components that make the case possible.
model ImplantSku {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  brand      String
  line       String
  platform   String
  /// Millimetres. Null on components that are not dimension-specific.
  diameterMm Float? @map("diameter_mm")
  lengthMm   Float? @map("length_mm")

  /// IMPLANT | HEALING_ABUTMENT | IMPRESSION_COMPONENT | PROSTHETIC_COMPONENT
  componentType String @map("component_type")

  quantity Int       @default(0)
  batchRef String?   @map("batch_ref")
  expiryAt DateTime? @map("expiry_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, clinicId, componentType])
  @@map("implant_skus")
}

// ---------------------------------------------------------------------------
// Sterilization — a batch, not a closing tick
// ---------------------------------------------------------------------------

/// Sheet L is emphatic: "don't manage sterilization as one closing tick."
/// A batch travels stages, and a failed cycle cannot release packs.
model SterilizationBatch {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  batchRef String @map("batch_ref")
  /// COLLECTED → ULTRASONIC → INSPECTED → PACKED → AUTOCLAVED → VERIFIED →
  /// RELEASED, with QUARANTINED and FAILED as terminal branches.
  stage    String @default("COLLECTED")

  operatorEmployeeId String? @map("operator_employee_id") @db.Uuid
  packCount          Int     @default(0) @map("pack_count")

  cycleNumber  String?   @map("cycle_number")
  cycleStartAt DateTime? @map("cycle_start_at") @db.Timestamptz(6)
  cycleEndAt   DateTime? @map("cycle_end_at") @db.Timestamptz(6)
  /// PASS | FAIL | INCONCLUSIVE. Inconclusive holds the batch rather than
  /// forcing a two-valued answer — see the CycleResult enum.
  cycleResult  String?   @map("cycle_result")

  releasedByEmployeeId String?   @map("released_by_employee_id") @db.Uuid
  releasedAt           DateTime? @map("released_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, batchRef])
  @@index([organizationId, clinicId, stage])
  @@map("sterilization_batches")
}

/// A laboratory case, through the lifecycle sheet K sets out:
/// Created → Dispatched → In production → Received → QC → Patient ready →
/// Delivered → Closed, with QC failure branching to Remake.
///
/// The rule this table exists to enforce is the requirement's most-cited
/// example: a crown delivery appointment requires Lab Received = YES **AND**
/// QC = PASSED. Booking one before both are true is the failure that the CAPA
/// parameter was introduced to learn from, and it is now impossible rather
/// than merely regrettable.
model LabCase {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  /// Human-facing reference, LAB-YYYY-NNNN. Stable once issued.
  reference String
  patientId String @map("patient_id") @db.Uuid

  vendor   String
  workType String  @map("work_type")
  toothRef String  @map("tooth_ref")
  shade    String?
  material String?

  status String @default("CREATED")

  dispatchedAt     DateTime? @map("dispatched_at") @db.Timestamptz(6)
  /// Mandatory at dispatch (LAB-007). A case with no expected return cannot be
  /// late, which is the same as never being chased.
  expectedReturnAt DateTime? @map("expected_return_at") @db.Timestamptz(6)
  receivedAt       DateTime? @map("received_at") @db.Timestamptz(6)

  /// Doctor QC (LAB-005). PASS | FAIL, and null until somebody has looked.
  qcResult       String?   @map("qc_result")
  qcByEmployeeId String?   @map("qc_by_employee_id") @db.Uuid
  qcAt           DateTime? @map("qc_at") @db.Timestamptz(6)
  qcNote         String?   @map("qc_note")

  /// How many times this case has been remade. A second remake is a different
  /// conversation from a first, and only visible if the count survives.
  remakeCount Int @default(0) @map("remake_count")

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId, clinicId, status])
  @@index([expectedReturnAt])
  @@map("lab_cases")
}

/// An attempt to bring a dormant patient back, and what they said.
///
/// Detection is not stored — a patient is dormant or not according to
/// `dormancyOf()` at the instant you ask, because a stored flag is wrong the
/// moment somebody books. What is stored is the call: that it happened, who
/// made it, and the answer. See packages/contracts/src/retention.ts.
model RetentionOutreach {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  patientId      String @map("patient_id") @db.Uuid

  /// NEVER_STARTED | STOPPED_MID_TREATMENT, as at the moment it was raised.
  reason      String
  daysDormant Int      @map("days_dormant")
  raisedAt    DateTime @default(now()) @map("raised_at") @db.Timestamptz(6)

  contactedAt           DateTime? @map("contacted_at") @db.Timestamptz(6)
  contactedByEmployeeId String?   @map("contacted_by_employee_id") @db.Uuid
  /// RETURNING | DECLINED | WILL_DECIDE | NO_ANSWER | UNREACHABLE | NOT_APPLICABLE
  outcome               String?
  /// What the patient said. The reason the list is worth keeping.
  note                  String?

  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([organizationId, clinicId, closedAt])
  @@map("retention_outreach")
}

/// The event log. Specification §16 — the only writable table in the model.
///
/// Flows, ownership, timers and governance state are all replayed from this
/// and none of them has a column anywhere. Append-only by database grant: the
/// application role holds SELECT and INSERT and nothing else.
model ClinicEventRow {
  seq            BigInt @id @default(autoincrement())
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  type         String
  subjectId    String  @map("subject_id")
  subjectLabel String? @map("subject_label")

  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  /// Clinic-local minutes since midnight, as the engine reasons in.
  occurredMinute Int      @map("occurred_minute")

  byEmployeeId String? @map("by_employee_id") @db.Uuid
  byRole       String  @map("by_role")

  payload Json @default("{}")

  /// The caller's own id. A retried request inserts nothing the second time.
  idempotencyKey String @map("idempotency_key")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, clinicId, seq])
  @@index([organizationId, subjectId])
  @@map("clinic_events")
}

/// The operatory master. Four for this clinic, but a row count rather than a
/// constant — a fifth operatory is an INSERT, not a release.
model Operatory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid

  label    String
  /// Left to right along the corridor.
  position Int

  /// The four standard checks. Master data, so a room without an x-ray is
  /// configuration rather than something a person has to remember.
  hasChair       Boolean @default(true) @map("has_chair")
  hasXray        Boolean @default(true) @map("has_xray")
  hasSuction     Boolean @default(true) @map("has_suction")
  hasInstruments Boolean @default(true) @map("has_instruments")

  /// Archived, never deleted.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, clinicId])
  @@map("operatories")
}

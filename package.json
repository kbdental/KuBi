{
  "name": "kubi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:ui && pnpm test:integration",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "pnpm --filter @kubi/web dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "argon2"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.8",
      "find-my-way": ">=9.7.0",
      "vite": ">=6.4.3"
    }
  },
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@kubi/contracts": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "argon2": "^0.45.1",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  }
}
